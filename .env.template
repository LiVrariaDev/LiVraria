# [WARNING]
# 1. このテンプレートをコピーして、ファイル名を.envへ変更してください.
# 2. `.env`は必ず`.gitignore`に追加してください.

# Firebase Admin SDK (Backend)
FIREBASE_ACCOUNT_KEY_PATH=
FIREBASE_API_KEY=

# Firebase Config (Frontend - Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional Frontend API
# When connecting from outside localhost, enter the address of the server running this backend.
# VITE_API_BASE_URL=

# Allowed CORS Origins (Backend)
# 端末のブラウザが開くフロントエンドのオリジン（localhost:5173 は自動で含まれます）
# 例: ALLOWED_ORIGINS=http://192.168.0.10:5173  （旧名 PRODUCTION_ORIGINS も使用可）
# ALLOWED_ORIGINS=

# Device Key（端末共有キー）
# NFC ログインを許可する端末の判別に使う。バックエンドと各端末で同じ値にする。
# 例: openssl rand -hex 32 で生成
# Backend 側
LIVRARIA_DEVICE_KEY=
# 端末（フロントエンド）側
VITE_DEVICE_KEY=

# デバッグ API とトレース記録（開発用 PC でのみ true にする）
# LIVRARIA_DEBUG=false
# デバッグ API の管理者キー（LIVRARIA_DEVICE_KEY とは別の値。openssl rand -hex 32 などで生成）
# LIVRARIA_ADMIN_KEY=
# メモリに残すターン数
# LIVRARIA_TRACE_LIMIT=500

# Backend SSL Configuration
# マイク入力などHTTPSが必要な機能を使用する場合はtrueに設定
# USE_SSL=false

# Gemini API
GEMINI_API_KEY=
# 役割ごとの Gemini モデル（未設定時は下の値）
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_SUMMARY_MODEL=gemini-4-hydrogen
# GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Gemini SDK のリトライ回数とタイムアウト(秒)
# GEMINI_API_MAX_RETRIES=1
# GEMINI_API_TIMEOUT=30

# Rakuten Books API
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# CiNii Books API（大学図書館検索）
# https://support.nii.ac.jp/ja/cinii/api/developer で申請した appid
CINII_APPID=

# Optional: MongoDB Configuration
# MONGODB_URI=mongodb://localhost:27017